{
	"schemaVersion": 1,
	"id": "catgodneko-compression",
	"version": "${version}",
	"name": "Compression Mod",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"CatGodNeko"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/compression/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"catgodneko.compression.Compression"
		],
		"client": [
			"catgodneko.compression.client.CompressionClient"
		],
		"fabric-datagen": [
			"catgodneko.compression.client.CompressionDataGenerator"
		]
	},
	"mixins": [
		"compression.mixins.json",
		{
			"config": "compression.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}